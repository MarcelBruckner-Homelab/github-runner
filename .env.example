# One PAT per org/owner you register runners against. register.sh reads
# GH_PAT by default; pass --pat-name to pick a different variable.
#
#   org scope:  Organization permissions -> Self-hosted runners: Read and write
#   repo scope: Repository permissions   -> Administration: Read and write
GH_PAT=

# Example for a second org/owner:
# GH_PAT_TRAUREISE=
